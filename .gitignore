# OS
.DS_Store
Thumbs.db
desktop.ini

# Gradle
/[Aa]ssets/Plugins/Android/[Bb]uild/

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# TextMeshPro
/[Aa]ssets/TextMesh Pro/

# Recordings
/[Aa]ssets/StreamingAssets/

# Screenshots at root
*.png

# Claude Code agent worktrees
.claude/worktrees/

# Pre-Core-60 generated SOs archived by ArchiveLegacySos (M1 Chunk 2.9 / Vol 5.1).
# Recoverable on disk; not tracked because they're large and superseded by items_core.json.
/[Aa]ssets/[Ss]criptable[Oo]bjects/_Archived/
