  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: bone_colossus
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: bone_colossus
  displayName: Bone Colossus
  description: A multi-skeleton Kin amalgam, fused into one giant. In the Badlands'
    Bone Reach.
  tier: 1
  family: 1
  behaviors:
  - "Each skull is a separate weak point \u2014 destroy them in sequence to weaken
    him."
  - While skulls remain, regenerates over time.
  - Different arms wield different weapons (hammer, spear, claw).
  - 'Final phase: collapses into a single skeleton and becomes much faster.'
  abilities:
  - "Multi-Limb Assault \u2014 strikes from several angles at once"
  - "Bone Erupt \u2014 pillars of bone burst from the ground"
  - "Skull Howl \u2014 area fear, scrambles player aim briefly"
  - "Reassemble \u2014 picks up fallen skull bones to regrow"
  dropItemIds:
  - Colossal Marrow (giant-scale building blocks)
  - Bone Plate x20
  - Heart Fragment (1 of 7)
  - Spirit Anchor (the original Kin who was 'first' in the fusion)
  boss_section: Warden Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
