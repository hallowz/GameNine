  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: carapace_apostle
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: carapace_apostle
  displayName: Carapace Apostle
  description: A Kin who chose corruption voluntarily. Worships VORD. Faces the player
    as a willing servant of the rift.
  tier: 1
  family: 4
  behaviors:
  - Will negotiate, but only for the player to surrender to VORD willingly.
  - "Fights without remorse \u2014 believes they are saving the player."
  - Has access to multiple Vord abilities simultaneously.
  - 'Asks the player at half HP: ''Why do you struggle against peace?'''
  abilities:
  - "Apostle's Conversion \u2014 instant kill if player gets too close"
  - "Carapace Bash \u2014 heavy melee"
  - "Vord Ritual \u2014 summons abyssal tendrils"
  - "Acceptance \u2014 at 1 HP, asks player to free them or convert"
  dropItemIds:
  - Heart Fragment (1 of 7)
  - Apostle's Carapace (prestige armor)
  - Vord Cipher x3 (decoded lore)
  - "Spirit Anchor (problematic \u2014 Apostle's choice persists in spirit form)"
  boss_section: Aberrant Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
