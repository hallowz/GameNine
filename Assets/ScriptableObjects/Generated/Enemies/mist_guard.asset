  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: mist_guard
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: mist_guard
  displayName: Mist Guard
  description: In a Sky Island fortress perpetually shrouded in cloud. Visibility
    is the central challenge.
  tier: 1
  family: 1
  behaviors:
  - Visible only when attacking.
  - Moves silently through mist when between attacks.
  - "Has a clear 'wind-up' sound before each strike \u2014 audio cues critical."
  - Cleared mist by stunning him with sonic attacks reveals his True position.
  abilities:
  - "Mist Step \u2014 teleports through fog"
  - "Twin Cleave \u2014 paired blade strikes"
  - "Veil Cloak \u2014 increases ambient mist density"
  - "Gale Step \u2014 knocks player off platform edge"
  dropItemIds:
  - Mist-Walker Cloak (stealth armor)
  - Cloud Crystal (sky vehicle component)
  - Heart Fragment (1 of 7)
  - Spirit Anchor
  boss_section: Warden Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
