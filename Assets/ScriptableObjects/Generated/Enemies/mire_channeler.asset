  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: mire_channeler
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: mire_channeler
  displayName: Mire Channeler
  description: Tier 1 Channeler. Lives at the heart of a Fungal Marsh. Turns the
    arena against the player.
  tier: 1
  family: 3
  behaviors:
  - Stays at distance, channels environmental hazards.
  - Will not approach the player even if attacked in melee.
  - Vulnerable while channeling (3-second windows).
  - Surrounding water becomes acidic over time as fight progresses.
  abilities:
  - "Acid Pool \u2014 designates spots that bubble up after 2 seconds"
  - "Spore Squall \u2014 area cloud damage"
  - "Mire Tendrils \u2014 grasping vines from below"
  - "Channel: Drowning \u2014 slows player movement in water"
  dropItemIds:
  - Channeler's Staff Tip (alchemist masterwork tool)
  - Marshfern Pulp x6
  - Royal Jelly x2
  - Spirit Anchor (an old Kin apothecary)
  boss_section: Channeler Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
