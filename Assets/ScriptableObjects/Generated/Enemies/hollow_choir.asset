  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: hollow_choir
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: hollow_choir
  displayName: Hollow Choir
  description: In a Sky Island chapel. Six separate Kin singers must be killed in
    harmonic order or they heal each other.
  tier: 1
  family: 4
  behaviors:
  - Six bosses share an HP pool but cannot be killed in any order.
  - Player must identify the correct harmonic order by listening to each one's voice
    tone.
  - 'Killing wrong order: the remaining heal massively.'
  - 'Final stage: all six dissonate, become aggressive simultaneously.'
  abilities:
  - "Harmonic Note \u2014 individual sonic attack"
  - "Dissonance \u2014 collective AOE when out of order"
  - "Final Chorus \u2014 phase 2, all six attack together"
  - "Heal Echo \u2014 heals when one is killed in wrong order"
  dropItemIds:
  - Heart Fragment (1 of 7)
  - Chorus Crystal x6 (music gear)
  - Kin Diary (lore reveal)
  - Spirit Anchor (six separate, all bond as one in the Gateway)
  boss_section: Aberrant Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
