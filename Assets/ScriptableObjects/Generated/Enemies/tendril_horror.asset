  m_Name: tendril_horror
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: tendril_horror
  displayName: Tendril Horror
  description: Tier 3 Aberrant. Buried in the foundations of a sunken Kin temple
    in the Marshes. Reaches through walls.
  tier: 3
  family: 4
  behaviors:
  - Cannot move from its anchor.
  - "Strikes through walls \u2014 line-of-sight does not protect."
  - "Tendrils have individual HP \u2014 destroying them reduces attack rate."
  - 'Phase 2: the anchor lifts, becomes mobile but reduced damage.'
  abilities:
  - "Wall-Pierce Strike \u2014 tendril through cover"
  - "Sweep \u2014 multiple tendrils across a room"
  - "Tendril Regeneration \u2014 regrows lost limbs over time"
  - "Anchor Release \u2014 phase change, becomes mobile"
  dropItemIds:
  - Heart Fragment (1 of 7)
  - Aberrant Flesh x4 (mystic recipes)
  - Temple Heart-Stone (atlas + base upgrade)
  - Spirit Anchor (the original Kin temple keeper)
  boss_section: Aberrant Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
