  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: sky_hunter
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: sky_hunter
  displayName: Sky Hunter
  description: In a Sky Island spire, hunts from the air. The first fight that meaningfully
    uses aerial mobility.
  tier: 1
  family: 2
  behaviors:
  - Stays airborne almost the entire fight.
  - Player needs Glider/Gyrocopter or precise long-range to engage.
  - Lands only briefly to recover quivers.
  - Vulnerable during its dive-attacks.
  abilities:
  - "Skyserpent Volley \u2014 multi-arrow ranged attack"
  - "Dive Strike \u2014 committed high-speed dive, exposes weakness on miss"
  - "Wing Buffet \u2014 knocks player off platforms"
  - "Ascend \u2014 escapes to higher altitude when threatened"
  dropItemIds:
  - Skyserpent Bow (masterwork ranged weapon)
  - Driftwing Skin (aerial armor)
  - Heart Fragment (1 of 7)
  - Spirit Anchor
  boss_section: Hunter Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
