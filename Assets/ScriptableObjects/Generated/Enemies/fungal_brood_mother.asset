  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: fungal_brood_mother
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: fungal_brood_mother
  displayName: Fungal Brood Mother
  description: 'Act 1 boss for M6. Lurks in the hand-placed stronghold. Tier 1 -
    designed to validate the multi-path boss framework at the smallest scale: a frontal
    weak point, a glowing back weak point, vulnerability to poison bait. Players
    who explored the synergy sandbox in M2 should find multiple paths to victory.'
  tier: 1
  family: 0
  behaviors:
  - Stays mostly stationary, rarely chases.
  - Spawns 'Spore Mites' (small fast adds) every ~15 seconds.
  - Telegraphs sac-burst attacks 2 seconds before triggering.
  - Becomes more aggressive below 30% HP, releases panic spore-cloud.
  - Glowing back weak point exposed during sac-burst windup.
  - Vulnerable to poison bait (a 'weird path' kill validated in M6).
  abilities:
  - Spore-Sac Burst - AOE poison cloud, leaves lingering damage zone
  - Fungal Spawn - summons 3-5 Spore Mites
  - Tendril Lash - short-range pull toward her
  - Death Bloom - final ability, releases all stored spores
  dropItemIds:
  - Spirit Anchor (her Kin memory) - required to insert at the Spirit Gateway in
    M6
  - Spore Cluster x3-5
  - Glandular Sac (future Cheese Press / chem set ingredient)
  boss_section: Brood Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
