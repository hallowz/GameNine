  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: fungal_brood_mother
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: fungal_brood_mother
  displayName: Fungal Brood Mother
  description: "The first major boss. Lurks in a ruined Kin village basement in the
    Lowlands. Tier 1 \u2014 designed to teach players the boss-fighting loop."
  tier: 1
  family: 0
  behaviors:
  - Stays mostly stationary, rarely chases.
  - Spawns 'Spore Mites' (small fast adds) every ~15 seconds.
  - Telegraphs sac-burst attacks 2 seconds before triggering.
  - Becomes more aggressive below 30% HP, releases panic spore-cloud.
  abilities:
  - "Spore-Sac Burst \u2014 AOE poison cloud, leaves lingering damage zone"
  - "Fungal Spawn \u2014 summons 3-5 Spore Mites"
  - "Tendril Lash \u2014 short-range pull toward her"
  - "Death Bloom \u2014 final ability, releases all stored spores"
  dropItemIds:
  - "Cartographer's Lens (guaranteed \u2014 required for first Atlas)"
  - Spore Cluster x3-5
  - Glandular Sac (chem set bootstrap component)
  - Spirit Anchor (her Kin memory)
  boss_section: Brood Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
