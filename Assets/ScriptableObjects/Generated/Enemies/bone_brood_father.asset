  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: bone_brood_father
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: bone_brood_father
  displayName: Bone Brood Father
  description: A patriarchal corruption in the Badlands. Lives in the ribcage of
    a colossal Kin elder's skeleton, now half-buried in red sand.
  tier: 1
  family: 0
  behaviors:
  - Slower than Fungal but hits much harder.
  - "Spawns 'Bone Walkers' \u2014 skeletal minions that pursue relentlessly."
  - Uses sand as cover, occasionally burrows briefly.
  - Will retreat into his ribcage at low HP and channel a final attack.
  abilities:
  - "Bone Spike Wall \u2014 spawns barriers that block player movement"
  - "Marrow Lance \u2014 long-range bone projectile, high damage"
  - "Walker Summon \u2014 4-6 Bone Walkers join the fight"
  - "Ossuary Slam \u2014 close-range AOE, breaks player armor"
  dropItemIds:
  - Sharp Bone Tip x8 (taxidermy + ammo materials)
  - Father's Marrow (masterwork bow ingredient)
  - Sinew Bundle x3
  - Spirit Anchor
  boss_section: Brood Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
