  m_Name: vord_brood_queen
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: vord_brood_queen
  displayName: Vord Brood Queen
  description: Found in an abyssal pit beneath an old Kin temple. Closest creature
    to the original VORD form. Tier 3.
  tier: 3
  family: 0
  behaviors:
  - "Stationary \u2014 anchored to the pit by her own mass."
  - Continuous spawn rate of basic Vord Drones (8-12 in arena at all times).
  - Hits players from across the arena with elongated tendrils.
  - "Below 25% HP, becomes mobile by uprooting from the pit \u2014 much more dangerous."
  abilities:
  - "Tendril Sweep \u2014 rotating arena-wide attack"
  - "Drone Tide \u2014 endless spawn"
  - "Acid Spit \u2014 long-range ranged attack"
  - "Uproot (phase 2) \u2014 boss becomes mobile, chases player"
  dropItemIds:
  - Vord Marrow (rare, T3+ recipes)
  - Queen's Carapace x4 (prestige armor)
  - Heart Fragment (1 of 7)
  - "Spirit Anchor (rare \u2014 Queen partially retains identity)"
  boss_section: Brood Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
