  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: forgotten_king
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: forgotten_king
  displayName: Forgotten King
  description: Endgame. A corrupted Kin monarch ruling over his own stronghold. Dignified.
    Lucid. Asks the player to justify themselves before fighting. The moral hinge
    of Act 3.
  tier: 1
  family: 4
  behaviors:
  - "Speaks to the player throughout the fight \u2014 old Kin language."
  - Will not attack first; must be provoked.
  - If player tries to flee, lets them. (Saves quest for later.)
  - "Fights with skill and patience \u2014 uses every Warden/Channeler hybrid mechanic."
  abilities:
  - "Royal Decree \u2014 buffs his Vord fodder in the stronghold"
  - "Crown Burst \u2014 radial holy energy attack"
  - "Royal Guard Summon \u2014 calls Vord lieutenants"
  - "Final Oath \u2014 at 1 HP, asks for mercy or final blow"
  dropItemIds:
  - Heart Fragment (1 of 7)
  - King's Crown (cosmetic + parley unlock)
  - "Royal Codex (NPC unlock \u2014 Kin Council recipes)"
  - "Spirit Anchor (most powerful in the Gateway when freed \u2014 speaks the harshest
    truths)"
  boss_section: Aberrant Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
