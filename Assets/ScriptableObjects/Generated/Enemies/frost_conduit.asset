  m_Name: frost_conduit
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: frost_conduit
  displayName: Frost Conduit
  description: "Frozen Peaks, in a crystalline cathedral. Channels are the entire
    arena \u2014 pillars of ice that focus its power."
  tier: 1
  family: 3
  behaviors:
  - "Power is amplified by 4 ice pillars at the arena edges \u2014 destroy them to
    weaken her."
  - Each pillar destroyed reduces her abilities tier.
  - Slow movement but constant ranged barrage.
  - "Pillars regenerate slowly \u2014 managing them is the fight."
  abilities:
  - "Glacial Bolt \u2014 homing frost projectile"
  - "Pillar Resonance \u2014 area freeze under ice pillars"
  - "Frostfall \u2014 overhead ice rain in arena"
  - "Heart Beat \u2014 pulse AOE that scales with intact pillars"
  dropItemIds:
  - Frost Conduit Core (cryo engine prestige)
  - Frost Crystal x10
  - Cryo Gel x4
  - Spirit Anchor
  boss_section: Channeler Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
