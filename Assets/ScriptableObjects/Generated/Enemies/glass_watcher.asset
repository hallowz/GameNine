  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: glass_watcher
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: glass_watcher
  displayName: Glass Watcher
  description: In a crystalline cave system beneath the Fungal Marshes. Reflective
    surfaces mean every angle matters.
  tier: 1
  family: 1
  behaviors:
  - Reflects ranged attacks back at the player.
  - Must be fought in melee.
  - "Creates 'mirror copies' that look identical \u2014 only one is real."
  - Vulnerable when the cave's natural light hits its core directly.
  abilities:
  - "Refract \u2014 reflects a ranged shot back"
  - "Mirror Self \u2014 spawns 2 False copies"
  - "Crystal Shard Burst \u2014 close-range AOE"
  - "Prism Beam \u2014 laser when caught in direct light"
  dropItemIds:
  - Watcher's Lens (telescope + atlas upgrade material)
  - Glass x10, Silica Dust x6
  - Prism Core (energy weapon component)
  - Spirit Anchor
  boss_section: Warden Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
