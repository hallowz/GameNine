  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: the_hollow_source
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: the_hollow_source
  displayName: The Hollow Source
  description: "Act 4 first major fight. Inside the Citadel. A vast Vord creature
    woven from every type of Kin \u2014 smith, beekeeper, dancer, scholar. Cycles
    through their attack patterns."
  tier: 0
  family: 6
  behaviors:
  - Cycles through 6 attack patterns mirroring previous boss families.
  - Player must recognize the active pattern and respond accordingly.
  - Each pattern lasts 30-45 seconds.
  - "Fight is genuinely hard \u2014 players who skipped archetypes will struggle
    here."
  abilities:
  - "Smith Phase \u2014 heavy melee like a Warden"
  - "Channeler Phase \u2014 environmental hazards"
  - "Hunter Phase \u2014 stealth and pounces"
  - "Brood Phase \u2014 summons Vord minions"
  - "Apostle Phase \u2014 wide AOE"
  - "Final Cycle \u2014 all 6 simultaneously briefly"
  dropItemIds:
  - Hollow Crown (legendary cosmetic)
  - Source-Fragment (final atlas upgrade)
  - "Spirit Anchor (six in one \u2014 the Hollow Source contains all the original
    Council)"
  - Citadel Key (unlocks Choice Chamber)
  boss_section: Story Finale
  isBoss: 1
  isFinale: 1
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
