  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: echoing_heart
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: echoing_heart
  displayName: Echoing Heart
  description: In a vast underground cavern. Fights with copies of itself; the real
    one is hidden among echoes.
  tier: 1
  family: 4
  behaviors:
  - Spawns 4-6 identical decoys at start of fight.
  - "Real heart has a slightly different rhythm \u2014 audio cue critical."
  - Damaging a decoy heals the real one.
  - 'Phase 2: respawns decoys, faster cycles.'
  abilities:
  - "Sonic Pulse \u2014 area damage from real heart only"
  - "Decoy Mirror \u2014 spawns copies"
  - "Misdirection \u2014 swaps positions briefly"
  - "Sympathetic Resonance \u2014 wrong target damage heals real heart"
  dropItemIds:
  - Heart Fragment (1 of 7)
  - Echo Crystal (sonic gear)
  - True Heart-Sliver (Atlas upgrade)
  - "Spirit Anchor (multiple \u2014 the Heart was many people)"
  boss_section: Aberrant Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
