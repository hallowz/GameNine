  m_Name: frost_brood_lich
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: frost_brood_lich
  displayName: Frost Brood Lich
  description: Wreathed in perpetual blizzard in the Frozen Peaks. Was once a Kin
    elder revered for her ice-prophecies.
  tier: 1
  family: 0
  behaviors:
  - Floats slowly, never touches ground.
  - Spawns 'Frost Wisps' (fast, fragile, freeze on hit).
  - "Drops temperature in the arena over time \u2014 player needs cold protection."
  - Phases between physical and intangible states.
  abilities:
  - "Glacial Lance \u2014 three-bolt frozen volley"
  - "Wisp Tide \u2014 summons 6-8 Frost Wisps"
  - "Icebound \u2014 locks the player in place briefly"
  - "Hailstorm \u2014 area denial, falling ice shards"
  dropItemIds:
  - Frost Crystal x6 (cryo gear)
  - Lich's Pulse (cryo engine ingredient)
  - Glacial Robe Scrap (armor mat)
  - Spirit Anchor
  boss_section: Brood Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
