  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: bone_sigil_keeper
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: bone_sigil_keeper
  displayName: Bone Sigil-Keeper
  description: In a Kin burial complex. Channels through carved sigil-stones placed
    around the arena.
  tier: 1
  family: 3
  behaviors:
  - Power flows through 6 sigil-stones at the edges of the arena.
  - "Inscribe each stone takes time \u2014 interrupt or destroy them."
  - Heals when standing near intact sigils.
  - Becomes more dangerous as stones are removed (desperate phase).
  abilities:
  - "Sigil Channel \u2014 heals herself near stones"
  - "Bone Spear Inscription \u2014 creates spears from carved sigils"
  - "Soul Drain \u2014 short-range life-steal"
  - "Final Inscription \u2014 at 25% HP, etches the player's soul"
  dropItemIds:
  - Sigil-Keeper's Codex (mystic recipes unlock)
  - Sigil Carving x6 (mystic component)
  - Soul Essence x3
  - Spirit Anchor
  boss_section: Channeler Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
