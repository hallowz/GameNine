  m_Script: {fileID: 11500000, guid: c34eb5acfa10d0c4eaf2a89dc1f0b291, type: 3}
  m_Name: void_custodian
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: void_custodian
  displayName: Void Custodian
  description: Endgame Warden. In the deepest abyss, guarding the path to the Citadel.
    The most patient fight in the game.
  tier: 1
  family: 1
  behaviors:
  - Projectiles entering its darkness sphere are nullified.
  - Must be fought in melee or with attacks that pierce the sphere.
  - Counter-attacks every successful player hit with a precise riposte.
  - Telegraphs ultimate ability across the entire arena.
  abilities:
  - "Void Riposte \u2014 instant counter on player hit"
  - "Darkness Pulse \u2014 expands sphere temporarily"
  - "Lightless Lance \u2014 pierces armor, ignores cover"
  - "Final Eclipse \u2014 arena-wide darkness for 5 seconds"
  dropItemIds:
  - Custodian's Mantle (prestige cloak)
  - Void Crystal x2
  - Heart Fragment (1 of 7)
  - Spirit Anchor (one of the original Kin Council)
  boss_section: Warden Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
