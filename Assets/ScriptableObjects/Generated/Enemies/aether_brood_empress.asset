  m_Name: aether_brood_empress
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: aether_brood_empress
  displayName: Aether Brood Empress
  description: Floats serenely above a Sky Island throne. Surrounded by hovering
    shards of crystal that drift in mathematical patterns.
  tier: 1
  family: 0
  behaviors:
  - "Highly mobile \u2014 teleports short distances around the arena."
  - "Spawns 'Aether Mites' \u2014 mini-bosses that mirror her teleport."
  - Vulnerable only when her crown shards align overhead (3-second window).
  - "Uses gravity attacks \u2014 pulls or pushes the player off platforms."
  abilities:
  - "Crown Shard Volley \u2014 fires orbital shards in spiraling arcs"
  - "Gravity Reverse \u2014 flips up/down briefly"
  - "Mite Manifest \u2014 3 Aether Mites appear from rifts"
  - "Imperial Decree \u2014 temporary invulnerability + summons"
  dropItemIds:
  - Aether Distillate x2 (T4 engine fuel)
  - Empress Shard (sky vehicle component)
  - Void Dust x4
  - Spirit Anchor
  boss_section: Brood Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
