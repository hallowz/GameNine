  m_Name: spore_hunter
  m_EditorClassIdentifier: Voidborne::Voidborne.Enemies.V2.EnemyDefinition
  id: spore_hunter
  displayName: Spore Hunter
  description: Deep in the Fungal Marshes, a Kin who became one with the spores.
    Toxic, fast, terrifying.
  tier: 1
  family: 2
  behaviors:
  - "Leaves spore zones wherever it walks \u2014 visible damage trails."
  - Faster than other Hunters but more predictable in attack patterns.
  - Vulnerable to fire damage.
  - Becomes more aggressive at low HP and stops leaving zones (focused on player).
  abilities:
  - "Spore Claw \u2014 close-range AOE poison"
  - "Trail Mark \u2014 leaves a damage zone behind"
  - "Bloom Burst \u2014 circular poison release"
  - "Berserker Rush \u2014 final phase, ignores zones to chase player"
  dropItemIds:
  - Spore Cluster x6
  - Hunter's Fungal Spur (poison weapon mat)
  - Bio Sac x4
  - Spirit Anchor
  boss_section: Hunter Family
  isBoss: 1
  isFinale: 0
  baseHealth: 30
  baseSpeed: 4
  prefab: {fileID: 0}
