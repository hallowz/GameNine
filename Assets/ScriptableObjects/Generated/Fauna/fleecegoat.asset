  id: fleecegoat
  displayName: Fleecegoat
  description: Hill-dwelling small fauna. Source of wool and milk.
  behaviors:
  - Climbs cliffs other fauna can't.
  - Lets player shear it for wool without killing.
  - Can be milked at Auto-Milker.
  - Aggressive only if cornered.
  habitat: Lowlands Fauna
  dropItemIds:
  - Wool x2-3 (passive shear)
  - Milk x1 (auto-milker)
  - Raw Meat x1-2 (if killed)
  isTameable: 0
  isPassive: 0
  isAggressive: 1
  baseHealth: 50
  baseSpeed: 3
