  m_Name: the_caravan_master
  m_EditorClassIdentifier: Voidborne::Voidborne.NPCs.NpcDefinition
  id: the_caravan_master
  displayName: The Caravan Master
  description: Leads a caravan of 4-5 NPCs. Only visits if the player has high merchant
    relations.
  section: Travelling Merchants
  behaviors:
  - Visits monthly with a full caravan.
  - Brings bulk goods and rare materials.
  - Hires the player for delivery missions.
  - Provides discounts based on Trader's Ledger.
  abilities:
  - Sells in bulk.
  - Offers protection contracts.
  - Carries materials from distant regions.
  dropOrTradeItems:
  - Trade only.
  - 'On death of any caravan member: faction loss, no more visits.'
