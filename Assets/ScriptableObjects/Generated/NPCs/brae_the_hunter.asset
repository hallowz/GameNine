  m_Name: brae_the_hunter
  m_EditorClassIdentifier: Voidborne::Voidborne.NPCs.NpcDefinition
  id: brae_the_hunter
  displayName: Brae the Hunter
  description: Fourth rescued Kin. Found in the Frozen Peaks. Hunted the Frost Reaver
    before being rescued.
  section: Kin Survivors
  behaviors:
  - Goes on hunts with the player if invited.
  - Provides intelligence about distant strongholds.
  - Trains the player in tracking (unlocks Hunter's Hood crafting).
  - Sleeps in the Scout's Tent at the base.
  abilities:
  - Offers Hunter quests through the Bounty Board.
  - Unlocks 4 Hunter-archetype recipes.
  - Will accompany the player into difficult zones (rare).
  dropOrTradeItems:
  - Cannot be killed (escapes danger).
  - 'Death: Spirit unlocks tracking-related legendary tools.'
  isKillable: 0
  isQuestGiver: 1
