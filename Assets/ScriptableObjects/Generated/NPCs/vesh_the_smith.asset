  m_Script: {fileID: 11500000, guid: d28f5858218f1554aa43abaa8b8b6dcf, type: 3}
  m_Name: vesh_the_smith
  m_EditorClassIdentifier: Voidborne::Voidborne.NPCs.NpcDefinition
  id: vesh_the_smith
  displayName: Vesh the Smith
  description: Third rescued Kin. Found in a Badlands forge ruin. Was a smith before
    the corruption.
  section: Kin Survivors
  behaviors:
  - Works at the Smith's Anvil Station at the base.
  - Crafts masterwork weapons on request.
  - "Knew Wren before the fall \u2014 their reunion is emotional."
  - Tells stories about old smiths of the Council.
  abilities:
  - Unlocks 5 smith masterwork weapon recipes.
  - Will repair any item for free.
  - 'Personality: stoic, sentimental once you earn her trust.'
  dropOrTradeItems:
  - Cannot be killed.
  - 'Death: Spirit unlocks legendary forge recipes.'
  isKillable: 0
  isQuestGiver: 1
