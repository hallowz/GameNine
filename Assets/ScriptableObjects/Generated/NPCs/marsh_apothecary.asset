  m_Script: {fileID: 11500000, guid: d28f5858218f1554aa43abaa8b8b6dcf, type: 3}
  m_Name: marsh_apothecary
  m_EditorClassIdentifier: Voidborne::Voidborne.NPCs.NpcDefinition
  id: marsh_apothecary
  displayName: Marsh Apothecary
  description: Second rescued Kin. Found in the Fungal Marshes. Was once an alchemist
    for the Kin Council.
  section: Kin Survivors
  behaviors:
  - Lives at the player's base.
  - Operates a Chemistry Set near his bed.
  - Brews unique potions on request.
  - Gives the player the Chemistry Set recipe.
  abilities:
  - Unlocks 5 alchemist masterwork recipes.
  - Will accept ingredients in exchange for prepared potions.
  - Mutters about plants and bugs constantly.
  - 'Personality: distracted, kind, deeply curious.'
  dropOrTradeItems:
  - Cannot be killed.
  - 'Death: Spirit becomes one of the first Gateway residents (after natural in-game
    time).'
  isKillable: 0
  isQuestGiver: 1
  prefab: {fileID: 0}
